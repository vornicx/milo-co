<!doctype html>
<html lang="{{ request.locale.iso_code | escape }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#183D31">
<meta name="referrer" content="strict-origin-when-cross-origin">
{% render 'seo-meta' %}
{% if blogs['guias'].articles_count > 0 %}<link rel="alternate" type="application/atom+xml" title="Guías de paseo · Milo &amp; Co" href="{{ blogs['guias'].url }}.atom">{% endif %}
{{ 'milo-system.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milo.js' | asset_url }}" defer></script>
{{ content_for_header }}
</head><body>
<a class="skip" href="#MainContent">Saltar al contenido</a>
{% section 'header' %}
<main id="MainContent">{{ content_for_layout }}</main>
{% section 'footer' %}
</body></html>
