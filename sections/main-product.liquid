<section class="native-product wrap" data-product-page>
  <div class="native-product-media">
    {% assign primary_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
    {% if primary_image %}{{ primary_image | image_url: width: 1800 | image_tag: widths: '480, 800, 1200, 1800', sizes: '(max-width: 760px) 90vw, 58vw', loading: 'eager', data-variant-image: '' }}{% endif %}
    {% for image in product.images %}
      {% unless image.id == primary_image.id %}
      {{ image | image_url: width: 1800 | image_tag: widths: '480, 800, 1200, 1800', sizes: '(max-width: 760px) calc(100vw - 32px), 58vw', loading: 'lazy' }}
      {% endunless %}
    {% endfor %}
  </div>
  <div class="native-product-panel">
    <p class="eyebrow">MILO & CO · PRODUCTO</p>
    <h1>{{ product.title | escape }}</h1>
    <div class="prose">{{ product.description }}</div>
    {% if settings.sales_enabled %}{% render 'product-form', item: product %}{% else %}
      <div class="prelaunch-inline"><p>Estamos preparando el lanzamiento. Déjanos tu correo y te avisaremos.</p>{% render 'prelaunch-form', id: section.id, source: 'product_general_top', privacy_policy: shop.privacy_policy %}</div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
