<section class="journal wrap">
  <nav class="breadcrumbs" aria-label="{{ 'organic.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'organic.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
  <header class="journal-heading"><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="prose">{{ collection.description }}</div>{% else %}<p>{{ 'organic.catalog_intro' | t }}</p>{% endif %}</header>
  {% paginate collection.products by 12 %}
  <div class="guide-grid">
    {% for item in collection.products %}
      <article class="guide-card"><a href="{{ item.url }}">
        {% if item.featured_image %}{{ item.featured_image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(max-width: 760px) 90vw, 30vw', loading: 'lazy' }}{% endif %}
        <h2>{{ item.title | escape }}</h2><p>{{ item.price | money }}</p><span class="text-link">{{ 'organic.view_product' | t }} {% render 'arrow' %}</span>
      </a></article>
    {% else %}<p>{{ 'organic.empty_products' | t }}</p>{% endfor %}
  </div>
  {% if paginate.pages > 1 %}<nav class="journal-pagination" aria-label="{{ 'organic.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Colección de productos","settings":[]}
{% endschema %}
