{% assign photo_alt = 'pupit.hero.alt' | t %}
<section class="pupit-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="pupit-hero__content pupit-container">
    <h1 id="HeroTitle-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape | newline_to_br }}{% else %}{{ 'pupit.hero.heading' | t | escape | newline_to_br }}{% endif %}</h1>
    <p>{% if section.settings.text != blank %}{{ section.settings.text | escape }}{% else %}{{ 'pupit.hero.text' | t }}{% endif %}</p>
    <div class="pupit-hero__actions"><a class="pupit-button" href="{{ section.settings.link | default: '#funciones' }}">{{ 'pupit.hero.cta' | t }}</a>{% unless settings.sales_enabled %}<a class="pupit-link" href="#espera">{{ 'pupit.hero.secondary' | t }}{% render 'pupit-arrow' %}</a>{% endunless %}</div>
  </div>
  <div class="pupit-hero__stage" data-pupit-reveal>
    <picture>
      {% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{% endif %}
      {% render 'pupit-media', image: section.settings.image, filename: 'pupit-hero-duo.webp', alt: photo_alt, width: 1536, height: 1024, sizes: '(min-width: 750px) 900px, 100vw', loading: 'eager' %}
    </picture>
  </div>
</section>
{% schema %}
{"name":"Pupit · Portada","settings":[{"type":"textarea","id":"heading","label":"Título"},{"type":"textarea","id":"text","label":"Texto"},{"type":"image_picker","id":"image","label":"Producto con fondo transparente"},{"type":"image_picker","id":"mobile_image","label":"Producto para móvil (opcional)"},{"type":"url","id":"link","label":"Enlace del botón"}],"presets":[{"name":"Pupit · Portada"}]}
{% endschema %}
