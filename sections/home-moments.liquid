<section class="home-functions wrap" aria-labelledby="home-functions-title">
  <div class="home-functions-head">
    <p class="eyebrow">LISTO PARA CADA MOMENTO</p>
    <h2 id="home-functions-title">Un paseo. Todo contigo.</h2>
  </div>

  <div class="home-functions-grid">
    <article class="home-function-card">
      <figure>
        {% if section.settings.image_water != blank %}
          {{ section.settings.image_water | image_url: width: 1200 | image_tag: widths: '420, 720, 1000, 1200', sizes: '(max-width: 760px) 82vw, 33vw', loading: 'lazy', alt: 'El dispensador durante una pausa para beber' }}
        {% else %}
          {% render 'theme-image', filename: 'paseo-pausa.webp', alt: 'El dispensador durante una pausa para beber', width: 1122, height: 1402, sizes: '(max-width: 760px) 90vw, 50vw', loading: 'lazy', priority: 'auto' %}
        {% endif %}
      </figure>
      <div class="home-function-copy"><span>01</span><div><h3>Agua</h3><p>400 ml y bebedero integrado.</p></div></div>
    </article>

    <article class="home-function-card">
      <figure>
        {% if section.settings.image_food != blank %}
          {{ section.settings.image_food | image_url: width: 1200 | image_tag: widths: '420, 720, 1000, 1200', sizes: '(max-width: 760px) 82vw, 33vw', loading: 'lazy', alt: 'Comida preparada en el dispensador' }}
        {% else %}
          {% render 'theme-image', filename: 'milo-food-original.jpg', alt: 'Comida preparada en el dispensador', width: 1122, height: 1402, sizes: '(max-width: 760px) 90vw, 30vw' %}
        {% endif %}
      </figure>
      <div class="home-function-copy"><span>02</span><div><h3>Comida</h3><p>150 ml de espacio para comida o snacks.</p></div></div>
    </article>

    <article class="home-function-card">
      <figure>
        {% if section.settings.image_waste != blank %}
          {{ section.settings.image_waste | image_url: width: 1400 | image_tag: widths: '480, 800, 1100, 1400', sizes: '(max-width: 760px) 82vw, 33vw', loading: 'lazy', alt: 'Compartimento para bolsas de residuos' }}
        {% else %}
          {% render 'theme-image', filename: 'milo-waste-original.jpg', alt: 'Compartimento para bolsas de residuos', width: 1536, height: 1024, sizes: '(max-width: 760px) 90vw, 30vw' %}
        {% endif %}
      </figure>
      <div class="home-function-copy"><span>03</span><div><h3>Bolsas</h3><p>Un sitio para llevarlas a mano.</p></div></div>
    </article>
  </div>
</section>
{% schema %}
{
  "name":"Momentos de uso",
  "settings":[
    {"type":"image_picker","id":"image_water","label":"Foto · agua"},
    {"type":"image_picker","id":"image_food","label":"Foto · comida"},
    {"type":"image_picker","id":"image_waste","label":"Foto · residuos"}
  ]
}
{% endschema %}
