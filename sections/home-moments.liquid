{% capture food_src %}{% render 'milo-photo-src', name: 'food' %}{% endcapture %}
{% capture waste_src %}{% render 'milo-photo-src', name: 'waste' %}{% endcapture %}
<section class="home-use">
  <div class="wrap">
    <div class="section-intro">
      <p class="eyebrow">EN EL PASEO</p>
      <h2>Agua. Comida.<br>Residuos.</h2>
    </div>

    <div class="home-use-grid" aria-label="El producto en uso">
      <figure class="home-use-shot home-use-shot--large">
        {% if section.settings.image_water != blank %}
          {{ section.settings.image_water | image_url: width: 1800 | image_tag: widths: '600, 900, 1300, 1800', sizes: '(max-width: 760px) calc(100vw - 32px), 58vw', loading: 'lazy', alt: 'Una pausa durante el paseo' }}
        {% else %}
          <img src="{{ 'paseo-pausa.webp' | asset_url }}" width="1122" height="1402" loading="lazy" alt="Una pausa durante el paseo">
        {% endif %}
      </figure>

      <figure class="home-use-shot">
        {% if section.settings.image_food != blank %}
          {{ section.settings.image_food | image_url: width: 1400 | image_tag: widths: '480, 800, 1100, 1400', sizes: '(max-width: 760px) calc(100vw - 32px), 31vw', loading: 'lazy', alt: 'Dispensador con agua y comida' }}
        {% else %}
          <img src="{{ food_src | strip }}" width="1122" height="1402" loading="lazy" alt="Dispensador con agua y comida preparado para salir">
        {% endif %}
      </figure>

      <figure class="home-use-shot">
        {% if section.settings.image_waste != blank %}
          {{ section.settings.image_waste | image_url: width: 1500 | image_tag: widths: '480, 800, 1200, 1500', sizes: '(max-width: 760px) calc(100vw - 32px), 31vw', loading: 'lazy', alt: 'Compartimento para bolsas de residuos' }}
        {% else %}
          <img src="{{ waste_src | strip }}" width="1536" height="1024" loading="lazy" alt="Dispensador con el compartimento para bolsas de residuos en uso">
        {% endif %}
      </figure>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Momentos de uso",
  "settings":[
    {"type":"image_picker","id":"image_water","label":"Foto · paseo / agua"},
    {"type":"image_picker","id":"image_food","label":"Foto · comida"},
    {"type":"image_picker","id":"image_waste","label":"Foto · residuos"}
  ]
}
{% endschema %}
