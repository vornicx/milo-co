{% capture food_src %}{% render 'milo-photo-src', name: 'food' %}{% endcapture %}
{% capture waste_src %}{% render 'milo-photo-src', name: 'waste' %}{% endcapture %}
<section class="home-moments wrap" aria-labelledby="home-moments-title">
  <div class="home-moments-head">
    <p class="eyebrow">HECHO PARA USARLO</p>
    <h2 id="home-moments-title">Sale contigo.<br>Vuelve contigo.</h2>
  </div>
  <div class="home-moments-grid">
    <figure class="home-moment home-moment--hero">
      {% if section.settings.image_water != blank %}
        {{ section.settings.image_water | image_url: width: 1600 | image_tag: widths: '480, 800, 1200, 1600', sizes: '(max-width: 760px) 84vw, 48vw', loading: 'lazy', alt: 'Una pausa durante el paseo' }}
      {% else %}
        <img src="{{ 'paseo-pausa.webp' | asset_url }}" width="1122" height="1402" loading="lazy" alt="Una pausa durante el paseo">
      {% endif %}
    </figure>
    <figure class="home-moment">
      {% if section.settings.image_food != blank %}
        {{ section.settings.image_food | image_url: width: 1200 | image_tag: widths: '420, 720, 1000, 1200', sizes: '(max-width: 760px) 84vw, 24vw', loading: 'lazy', alt: 'Dispensador con agua y comida' }}
      {% else %}
        <img src="{{ food_src | strip }}" width="1122" height="1402" loading="lazy" alt="Dispensador con agua y comida preparado para salir">
      {% endif %}
    </figure>
    <figure class="home-moment">
      {% if section.settings.image_waste != blank %}
        {{ section.settings.image_waste | image_url: width: 1400 | image_tag: widths: '480, 800, 1100, 1400', sizes: '(max-width: 760px) 84vw, 28vw', loading: 'lazy', alt: 'Compartimento para bolsas de residuos' }}
      {% else %}
        <img src="{{ waste_src | strip }}" width="1536" height="1024" loading="lazy" alt="Dispensador con el compartimento para bolsas de residuos en uso">
      {% endif %}
    </figure>
  </div>
</section>
{% schema %}
{
  "name":"Momentos de uso",
  "settings":[
    {"type":"image_picker","id":"image_water","label":"Foto · paseo / agua"},
    {"type":"image_picker","id":"image_food","label":"Foto · comida"},
    {"type":"image_picker","id":"image_waste","label":"Foto · residuos"}
  ]
}
{% endschema %}
