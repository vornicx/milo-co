<section class="walk-v2 wrap">
  <div class="walk-v2-intro">
    <p class="eyebrow">PASEOS Y ESCAPADAS</p>
    <h1>Fuera se está<br>mejor juntos.</h1>
    <p>Lo esencial preparado. El resto, a vuestro ritmo.</p>
  </div>

  <figure class="walk-v2-hero">
    {% render 'theme-image', filename: 'paseo.jpg', alt: 'Un perro durante una escapada al aire libre', width: 1536, height: 1024, sizes: '(max-width: 1440px) 100vw, 1440px', loading: 'eager', priority: 'high' %}
  </figure>

  <div class="walk-v2-moments" aria-label="Tres formas de salir">
    <article>
      <span>01</span>
      <h2>La vuelta.</h2>
      <p>Agua fresca y bolsas, incluso para la vuelta de siempre.</p>
    </article>
    <article>
      <span>02</span>
      <h2>El parque.</h2>
      <p>Haz una pausa para beber y busca sombra si aprieta el calor.</p>
    </article>
    <article>
      <span>03</span>
      <h2>La escapada.</h2>
      <p>Lleva agua adicional según la duración, el tiempo y las necesidades de tu perro.</p>
    </article>
  </div>
</section>

<section class="walk-v2-gallery wrap">
  <figure class="walk-v2-gallery-main">
    {% render 'theme-image', filename: 'paseo-pausa.webp', alt: 'Una pausa durante el paseo', width: 1122, height: 1402, sizes: '(max-width: 760px) 90vw, 50vw', loading: 'lazy', priority: 'auto' %}
  </figure>
  <figure>
    {% render 'theme-image', filename: 'paseo-esenciales.webp', alt: 'Lo esencial preparado para salir', width: 1254, height: 1254, sizes: '(max-width: 760px) 90vw, 50vw', loading: 'lazy', priority: 'auto' %}
  </figure>
  <figure>
    {% render 'theme-image', filename: 'dispensador-detalle.webp', alt: 'Detalle del dispensador de paseo', width: 1254, height: 1254, sizes: '(max-width: 760px) 90vw, 50vw', loading: 'lazy', priority: 'auto' %}
  </figure>
</section>

{% schema %}
{"name":"Walk Landing","settings":[]}
{% endschema %}
