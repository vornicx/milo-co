{% assign photo_alt = 'pupit.manifesto_alt' | t %}
<section class="pupit-manifesto pupit-container" aria-labelledby="ManifestoTitle-{{ section.id }}"><div data-pupit-reveal><h2 id="ManifestoTitle-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape | newline_to_br }}{% else %}{{ 'pupit.manifesto' | t | escape | newline_to_br }}{% endif %}</h2><p>{{ 'pupit.tagline' | t }}</p></div><figure>{% render 'pupit-media', image: section.settings.image, filename: 'paseo.jpg', alt: photo_alt, width: 1536, height: 1024, sizes: '(min-width: 750px) 90vw, 100vw' %}</figure></section>
{% schema %}
{"name":"Pupit · Manifiesto","settings":[{"type":"textarea","id":"heading","label":"Título"},{"type":"image_picker","id":"image","label":"Fotografía de paseo"}],"presets":[{"name":"Pupit · Manifiesto"}]}
{% endschema %}
