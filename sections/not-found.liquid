<section class="route-page route-page--404 wrap">
  <p class="eyebrow">ERROR 404</p>
  <h1>Este camino<br>no lleva a ninguna parte.</h1>
  <p>La página que buscas no existe o ha cambiado de sitio.</p>
  <div class="route-actions">
    <a class="button" href="{{ routes.root_url }}">Volver al inicio {% render 'arrow' %}</a>
    <a class="text-link" href="{{ settings.product_page.url | default: '/pages/dispensador' }}">Ver el dispensador {% render 'arrow' %}</a>
  </div>
</section>
{% schema %}
{"name":"Página 404","settings":[]}
{% endschema %}
