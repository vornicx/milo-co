{% assign sky_photo = 'dispenser-sky.webp' | asset_url %}{% assign pink_photo = 'dispenser-pink.webp' | asset_url %}
<section class="product-clean-colors wrap">
  <div class="product-clean-heading">
    <p class="eyebrow">AZUL CIELO · ROSA</p>
    <h2>Dos colores.<br>Una misma forma de salir.</h2>
  </div>

  <div class="product-clean-color-grid">
    <figure>
      <div class="product-clean-color-photo product-clean-color-photo--sky">
        <span class="product-color-brand" aria-hidden="true">MILO <i>&</i> CO.</span>
        <span class="product-color-code" aria-hidden="true">01 / SKY</span>
        <span class="product-color-shape" aria-hidden="true"></span>
        <img src="{{ sky_photo }}" alt="Dispensador Milo & Co en azul cielo" width="420" height="560" loading="lazy">
        <span class="product-color-caption" aria-hidden="true">PARA DÍAS DE SOL · Y LOS DEMÁS</span>
      </div>
      <figcaption><span class="sky"></span><strong>Azul cielo</strong><small>Suave, fresco y fácil de combinar.</small></figcaption>
    </figure>
    <figure>
      <div class="product-clean-color-photo product-clean-color-photo--pink">
        <span class="product-color-brand" aria-hidden="true">MILO <i>&</i> CO.</span>
        <span class="product-color-code" aria-hidden="true">02 / PINK</span>
        <span class="product-color-shape" aria-hidden="true"></span>
        <img src="{{ pink_photo }}" alt="Dispensador Milo & Co en rosa" width="420" height="560" loading="lazy">
        <span class="product-color-caption" aria-hidden="true">TODO LO ESENCIAL · EN UNA PIEZA</span>
      </div>
      <figcaption><span class="pink"></span><strong>Rosa</strong><small>Cálido, alegre y con personalidad.</small></figcaption>
    </figure>
  </div>
</section>

{% schema %}
{"name":"Dispenser Colors","settings":[]}
{% endschema %}
