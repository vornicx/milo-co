<section class="product-colors" id="colores">
  <div class="wrap">
    <div class="section-intro section-intro--center">
      <p class="eyebrow">COLORES</p>
      <h2>Azul cielo.<br>O rosa.</h2>
    </div>

    <figure class="product-colors-media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '700, 1100, 1600, 2200', sizes: '(max-width: 760px) calc(100vw - 32px), calc(100vw - 64px)', loading: 'lazy', alt: 'Dispensadores azul cielo y rosa' }}
      {% else %}
        <img src="{{ 'paseo-colores.webp' | asset_url }}" alt="Dispensadores azul cielo y rosa preparados para una escapada" width="1500" height="1000" loading="lazy">
      {% endif %}
    </figure>
  </div>
</section>
{% schema %}
{
  "name":"Dispensador · colores",
  "settings":[
    {"type":"image_picker","id":"image","label":"Fotografía de colores"}
  ]
}
{% endschema %}
