{% assign sky_photo = 'dispenser-sky.webp' | asset_url %}{% assign pink_photo = 'dispenser-pink.webp' | asset_url %}
<section class="product-clean-colors wrap">
  <div class="product-clean-heading">
    <p class="eyebrow">AZUL CIELO · ROSA</p>
    <h2>Dos colores.<br>Sin darle más vueltas.</h2>
  </div>

  <div class="product-clean-color-grid">
    <figure>
      <div class="product-clean-color-photo product-clean-color-photo--sky"><img src="{{ sky_photo }}" alt="Dispensador Milo & Co en azul cielo" width="420" height="560" loading="lazy"></div>
      <figcaption><span class="sky"></span><strong>Azul cielo</strong></figcaption>
    </figure>
    <figure>
      <div class="product-clean-color-photo product-clean-color-photo--pink"><img src="{{ pink_photo }}" alt="Dispensador Milo & Co en rosa" width="420" height="560" loading="lazy"></div>
      <figcaption><span class="pink"></span><strong>Rosa</strong></figcaption>
    </figure>
  </div>
</section>

{% schema %}
{"name":"Dispenser Colors","settings":[]}
{% endschema %}
