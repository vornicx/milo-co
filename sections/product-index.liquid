{% assign item = section.settings.product | default: settings.featured_product %}
{% assign product_link = item.url | default: settings.product_page.url | default: '/pages/dispensador' %}
{% capture food_src %}{% render 'milo-photo-src', name: 'food' %}{% endcapture %}
<section class="product-index wrap">
  <div class="product-index-intro">
    <p class="eyebrow">PRODUCTOS</p>
    <h1>Salir juntos,<br>con menos cosas.</h1>
    <p>{{ 'organic.catalog_intro' | t }}</p>
  </div>

  <a class="product-index-card" href="{{ product_link }}" aria-label="Ver dispensador 3 en 1" data-milo-event="product_click" data-milo-source="product_index">
    <div class="product-index-media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '520, 820, 1200, 1600, 1800', sizes: '(max-width: 760px) calc(100vw - 32px), 62vw', loading: 'eager', fetchpriority: 'high', alt: 'Dispensador Milo & Co preparado para salir' }}
      {% else %}
        <img src="{{ food_src | strip }}" width="1122" height="1402" fetchpriority="high" alt="Dispensador Milo & Co con agua y comida preparado para salir">
      {% endif %}
    </div>

    <div class="product-index-meta">
      <div>
        <p class="eyebrow">PARA EL PASEO</p>
        <h2>Dispensador 3 en 1</h2>
        <p class="product-index-summary">Lo que sueles llevar por separado, en una sola pieza.</p>
      </div>
      <div class="product-index-action">
        {% if settings.sales_enabled and item != blank %}
          <span class="product-index-price">{{ item.price | money }}</span>
        {% else %}
          <span class="product-index-status">Lista de espera abierta</span>
        {% endif %}
        <span class="text-link">Ver dispensador {% render 'arrow' %}</span>
      </div>
    </div>
  </a>
</section>
{% schema %}
{
  "name":"Índice de productos",
  "settings":[
    {"type":"product","id":"product","label":"Producto destacado"},
    {"type":"image_picker","id":"image","label":"Fotografía editorial"}
  ]
}
{% endschema %}
