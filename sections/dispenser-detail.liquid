<section class="product-hero-v2 wrap" data-product-page>
  <div class="product-hero-gallery">
    {% render 'dispenser-gallery' %}
  </div>

  <div class="product-hero-panel" id="product-purchase">
    <div class="product-hero-heading">
      <p class="eyebrow">OBJETO 01 · DISPENSADOR 3 EN 1</p>
      <h1>Menos cosas.<br>Más paseo.</h1>
      <p class="product-hero-lead">Agua, snacks y residuos. Siempre a mano.</p>
    </div>

    <div class="product-hero-specs" aria-label="Características principales">
      <span><strong>400 ml</strong><small>agua</small></span>
      <span><strong>150 ml</strong><small>comida</small></span>
      <span><strong>29 cm</strong><small>de alto</small></span>
    </div>

    {% if settings.featured_product != blank and settings.sales_enabled %}
      <div class="product-hero-purchase">
        {% render 'product-form', item: settings.featured_product %}
      </div>
    {% else %}
      <div class="product-hero-option">
        <span class="product-hero-option-label">Color</span>
        {% render 'color-preview' %}
      </div>

      <div class="product-hero-status">
        <span aria-hidden="true"></span>
        <strong>Próximamente</strong>
      </div>

      <a class="button product-hero-cta" href="#como-funciona">Verlo en el paseo {% render 'arrow' %}</a>
    {% endif %}
  </div>
</section>

<nav class="product-jump wrap" aria-label="Explora el dispensador">
  <a href="#como-funciona">Uso</a>
  <a href="#colores">Colores</a>
  <a href="#detalles">Detalles</a>
  <a href="#preguntas">Preguntas</a>
</nav>

{% if settings.featured_product != blank and settings.sales_enabled %}
  <div class="mobile-product-bar" aria-label="Compra rápida">
    <div>
      <small>{{ settings.featured_product.title | escape }}</small>
      <strong>{{ settings.featured_product.selected_or_first_available_variant.price | money }}</strong>
    </div>
    <a class="button" href="#product-purchase">Comprar</a>
  </div>
{% endif %}

{% schema %}
{"name":"Dispenser Detail","settings":[]}
{% endschema %}
