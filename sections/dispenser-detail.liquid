<section class="product-top wrap" data-product-page>
  <nav class="breadcrumbs" aria-label="Migas de pan">
    <a href="{{ routes.root_url }}">Inicio</a><span>/</span>
    <a href="{{ settings.products_page.url | default: '/pages/productos' }}">Productos</a><span>/</span>
    <span aria-current="page">Dispensador 3 en 1</span>
  </nav>

  <div class="product-top-grid">
    <div class="product-top-gallery">
      {% render 'dispenser-gallery' %}
    </div>

    <aside class="product-top-info" id="product-purchase">
      <p class="eyebrow">OBJETO 01</p>
      <h1>Dispensador<br>de paseo <span class="keep-together">3 en 1</span></h1>
      <p class="product-top-lead">Agua, comida y bolsas en un solo diseño.</p>

      <div class="product-icon-specs" aria-label="Características principales">
        <div>{% render 'milo-icon', name: 'water' %}<span><strong>400 ml</strong><small>agua</small></span></div>
        <div>{% render 'milo-icon', name: 'food' %}<span><strong>150 ml</strong><small>comida</small></span></div>
        <div>{% render 'milo-icon', name: 'ruler' %}<span><strong>29 cm</strong><small>de alto</small></span></div>
      </div>

      {% if settings.featured_product != blank and settings.sales_enabled %}
        {% render 'product-form', item: settings.featured_product %}
      {% else %}
        <div class="product-color-row">
          <span>Color</span>
          {% render 'color-preview' %}
        </div>
        <div class="product-availability" role="status"><span aria-hidden="true"></span>Próximamente</div>
      {% endif %}
    </aside>
  </div>
</section>

{% if settings.featured_product != blank and settings.sales_enabled %}
  <div class="mobile-product-bar" aria-label="Compra rápida">
    <div>
      <small>{{ settings.featured_product.title | escape }}</small>
      <strong>{{ settings.featured_product.selected_or_first_available_variant.price | money }}</strong>
    </div>
    <a class="button" href="#product-purchase">Comprar</a>
  </div>
{% endif %}

{% schema %}
{"name":"Dispenser Detail","settings":[]}
{% endschema %}
