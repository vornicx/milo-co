{% assign dispenser = product | default: settings.featured_product %}
<section class="product-top wrap" data-product-page data-milo-product-landing>
  <nav class="breadcrumbs" aria-label="Migas de pan">
    <a href="{{ routes.root_url }}">Inicio</a><span>/</span>
    {% if settings.sales_enabled %}<a href="{{ settings.products_page.url | default: '/pages/productos' }}">Productos</a><span>/</span>{% endif %}
    <span aria-current="page">Dispensador 3 en 1</span>
  </nav>

  <div class="product-top-grid">
    <div class="product-top-gallery">
      {% render 'dispenser-gallery', item: dispenser %}
    </div>

    <aside class="product-top-info" id="product-purchase">
      <p class="eyebrow">{{ 'organic.product_eyebrow' | t }}</p>
      <h1>Dispensador 3 en 1.<br><span class="keep-together">Listo para el paseo.</span></h1>
      <p class="product-top-lead">Agua, algo de comida y las bolsas: el dispensador reúne lo que sueles preparar por separado.</p>
      <nav class="product-section-links" aria-label="Información del dispensador"><a href="#como-funciona">Cómo funciona</a><a href="#detalles">Detalles</a><a href="#preguntas">Preguntas</a></nav>

      <div class="product-icon-specs" aria-label="Características principales">
        <div>{% render 'milo-icon', name: 'water' %}<span><strong>400 ml</strong><small>agua</small></span></div>
        <div>{% render 'milo-icon', name: 'food' %}<span><strong>150 ml</strong><small>comida</small></span></div>
        <div>{% render 'milo-icon', name: 'ruler' %}<span><strong>29 cm</strong><small>de alto</small></span></div>
      </div>

      {% if dispenser != blank and settings.sales_enabled %}
        {% render 'product-form', item: dispenser %}
      {% else %}
        <div class="product-color-row">
          <span>Color</span>
          {% render 'color-preview' %}
        </div>
        <p class="product-prelaunch-status"><span aria-hidden="true"></span>En preparación · venta todavía cerrada</p>
        <div class="prelaunch-inline" id="avisarme-{{ section.id }}">
          <p class="eyebrow">LISTA DE ESPERA</p>
          {% render 'prelaunch-form', id: section.id, source: 'product_top', privacy_policy: shop.privacy_policy %}
        </div>
      {% endif %}
    </aside>
  </div>
</section>

{% if dispenser != blank and settings.sales_enabled %}
  <div class="mobile-product-bar" aria-label="Compra rápida">
    <div>
      <small>{{ dispenser.title | escape }}</small>
      <strong data-mobile-price>{{ dispenser.selected_or_first_available_variant.price | money }}</strong>
    </div>
    <a class="button" href="#product-purchase">Comprar</a>
  </div>
{% endif %}
{% unless settings.sales_enabled %}
  <a class="mobile-waitlist-bar" href="#avisarme-{{ section.id }}" data-milo-event="cta_click" data-milo-source="mobile_product_bar"><span>Dispensador 3 en 1 <small>En preparación</small></span><strong>Apuntarme {% render 'arrow' %}</strong></a>
{% endunless %}

{% schema %}
{"name":"Dispenser Detail","settings":[]}
{% endschema %}
