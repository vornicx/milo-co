<section id="paseo" class="home-hero wrap">
  <div class="home-hero-copy">
    <p class="eyebrow">MILO & CO · PARA SALIR JUNTOS</p>
    <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
    <p class="home-hero-lead">{{ section.settings.text | escape }}</p>
    <a class="button" href="#dispensador">Ver el dispensador {% render 'arrow' %}</a>
  </div>

  <figure class="home-hero-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '640, 900, 1300, 1800, 2200', sizes: '(max-width: 760px) calc(100vw - 32px), 58vw', loading: 'eager', fetchpriority: 'high', alt: 'Dispensador Milo & Co preparado para un paseo' }}
    {% else %}
      <img src="{{ 'milo-food-use.avif' | asset_url }}" width="1122" height="1402" alt="Dispensador Milo & Co con agua y comida preparado para salir" fetchpriority="high">
    {% endif %}
  </figure>
</section>
{% schema %}
{
  "name":"Hero",
  "settings":[
    {"type":"textarea","id":"heading","label":"Título","default":"La vida fuera.\nEn buena compañía."},
    {"type":"textarea","id":"text","label":"Texto","default":"Lo esencial del paseo, siempre contigo."},
    {"type":"image_picker","id":"image","label":"Fotografía de portada"}
  ]
}
{% endschema %}
