<section id="paseo" class="campaign-hero wrap">
  <div class="campaign-copy">
    <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
    <p class="campaign-description">{{ 'organic.home_intro' | t }}</p>
    <a class="button" href="#dispensador" data-milo-event="cta_click" data-milo-source="home_hero">Descubrir el dispensador {% render 'arrow' %}</a>
  </div>

  <figure class="campaign-media{% if section.settings.image == blank and section.settings.mobile_image == blank %} campaign-media--lake{% endif %}">
    <picture>
      {% if section.settings.mobile_image != blank %}
        <source media="(max-width: 760px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
      {% endif %}
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '640, 900, 1300, 1800, 2200', sizes: '(max-width: 1440px) 100vw, 1440px', loading: 'eager', fetchpriority: 'high', alt: 'Dispensador Milo & Co preparado para un paseo' }}
    {% else %}
      {% render 'theme-image', filename: 'paseo.jpg', alt: 'Un momento de paseo en compañía de tu perro', width: 1536, height: 1024, sizes: '(max-width: 1440px) 100vw, 1440px', loading: 'eager', priority: 'high' %}
    {% endif %}
    </picture>
  </figure>
</section>
{% schema %}
{
  "name":"Hero",
  "settings":[
    {"type":"textarea","id":"heading","label":"Título","default":"Fuera, juntos."},
    {"type":"textarea","id":"text","label":"Texto","default":"Lo esencial del paseo, siempre contigo."},
    {"type":"image_picker","id":"image","label":"Fotografía de portada"},
    {"type":"image_picker","id":"mobile_image","label":"Fotografía de portada en móvil"}
  ]
}
{% endschema %}
