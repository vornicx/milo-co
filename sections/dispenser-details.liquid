<section id="detalles" class="product-details">
  <div class="wrap">
    <div class="product-details-head">
      <p class="eyebrow">DETALLES</p>
      <h2>Lo importante,<br>sin esconderlo.</h2>
    </div>

    <div class="product-details-grid">
      <figure class="product-details-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1500 | image_tag: widths: '520, 820, 1200, 1500', sizes: '(max-width: 760px) calc(100vw - 32px), 52vw', loading: 'lazy', alt: 'Detalle del dispensador Milo & Co' }}
        {% else %}
          <img src="{{ 'dispensador-detalle.webp' | asset_url }}" alt="Detalle del botón y la cuerda del dispensador Milo & Co" width="1254" height="1254" loading="lazy">
        {% endif %}
      </figure>

      <dl class="product-spec-list">
        <div><dt>Agua</dt><dd>400 ml</dd></div>
        <div><dt>Comida o snacks</dt><dd>150 ml</dd></div>
        <div><dt>Dimensiones</dt><dd>29 × 7,5 × 7,5 cm</dd></div>
        <div><dt>Incluye</dt><dd>Dispensador, cuerda de transporte y caja para residuos</dd></div>
        <div><dt>Material declarado</dt><dd>TPE</dd></div>
        <div><dt>Colores</dt><dd>Azul cielo y rosa</dd></div>
      </dl>
    </div>
    <p class="source-note">Especificaciones basadas en la ficha del proveedor.</p>
  </div>
</section>
{% schema %}
{
  "name":"Dispensador · detalles",
  "settings":[
    {"type":"image_picker","id":"image","label":"Fotografía de detalle"}
  ]
}
{% endschema %}
