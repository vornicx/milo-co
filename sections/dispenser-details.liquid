<section id="detalles" class="product-clean-details wrap">
  <div class="product-clean-heading">
    <p class="eyebrow">DETALLES</p>
    <h2>Lo importante,<br>claro.</h2>
  </div>

  <div class="product-detail-composition">
    <div class="product-macro">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 800, 1100, 1400', sizes: '(max-width: 760px) calc(100vw - 32px), 54vw', loading: 'lazy', alt: 'Detalle del dispensador Milo & Co' }}
      {% else %}
        <img src="{{ 'dispensador-detalle.webp' | asset_url }}" alt="Detalle del dispensador azul: botón, bebedero y cuerda de transporte" width="1254" height="1254" loading="lazy">
      {% endif %}
    </div>
    <dl class="product-clean-detail-list">
      <div><dt>Agua</dt><dd>400 ml</dd></div>
      <div><dt>Comida o snacks</dt><dd>150 ml</dd></div>
      <div><dt>Dimensiones</dt><dd>29 × 7,5 × 7,5 cm</dd></div>
      <div><dt>Incluye</dt><dd>Dispensador, cuerda de transporte y caja para residuos</dd></div>
      <div><dt>Material declarado</dt><dd>TPE</dd></div>
      <div><dt>Colores</dt><dd>Azul cielo y rosa</dd></div>
    </dl>
  </div>
  <p class="fine product-clean-source">Especificaciones basadas en la ficha del proveedor.</p>
</section>

{% schema %}
{
  "name":"Dispensador · detalles",
  "settings":[
    {"type":"image_picker","id":"image","label":"Fotografía macro / detalle"}
  ]
}
{% endschema %}
