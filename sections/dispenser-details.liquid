<section id="detalles" class="product-details">
  <div class="wrap">
    <div class="product-details-head">
      <p class="eyebrow">DETALLES</p>
      <h2>Todo en su sitio.</h2>
    </div>

    <div class="product-details-grid">
      <figure class="product-details-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1500 | image_tag: widths: '520, 820, 1200, 1500', sizes: '(max-width: 760px) calc(100vw - 32px), 52vw', loading: 'lazy', alt: 'Detalle del dispensador Milo & Co' }}
        {% else %}
          {% render 'theme-image', filename: 'milo-parts-original.jpg', alt: 'Dispensador Milo & Co desmontado con sus componentes y accesorios', width: 1254, height: 1254, sizes: '(max-width: 760px) 90vw, 50vw', loading: 'lazy', priority: 'auto' %}
        {% endif %}
      </figure>

      <div class="product-details-content">
        <ol id="como-funciona" class="product-preparation" aria-label="Cómo se prepara">
          <li><span>01</span>Prepara el agua y la comida en sus depósitos.</li>
          <li><span>02</span>Guarda las bolsas en el compartimento inferior.</li>
          <li><span>03</span>Monta las piezas y llévalo por la cuerda.</li>
        </ol>
      <dl class="product-spec-list">
        <div><dt>Agua</dt><dd>400 ml</dd></div>
        <div><dt>Comida o snacks</dt><dd>150 ml</dd></div>
        <div><dt>Dimensiones</dt><dd>29 × 7,5 × 7,5 cm</dd></div>
        <div><dt>Incluye</dt><dd>Dispensador, cuerda de transporte y caja para guardar bolsas</dd></div>
        <div><dt>Funcionamiento</dt><dd>Manual, sin batería</dd></div>
        <div><dt>Colores</dt><dd>Azul cielo y rosa</dd></div>
      </dl>
      </div>
    </div>
    <p class="source-note">Información técnica facilitada por el proveedor y pendiente de confirmación con la muestra. Comida y bolsas no incluidas.</p>
  </div>
</section>
{% schema %}
{
  "name":"Dispensador · detalles",
  "settings":[
    {"type":"image_picker","id":"image","label":"Fotografía de los componentes"}
  ]
}
{% endschema %}
