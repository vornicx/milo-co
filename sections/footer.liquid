<footer class="footer">
  <div class="wrap footer-top">
    <div>
      <a class="wordmark" href="{{ routes.root_url }}">milo & co<span>.</span></a>
      <p>La vida, en buena compañía.</p>
    </div>
    <nav aria-label="Información">
      {% if settings.sales_enabled %}
        <a href="{{ settings.products_page.url | default: '/pages/productos' }}">Productos</a>
      {% else %}
        <a href="{{ settings.product_page.url | default: '/pages/dispensador' }}">Dispensador 3 en 1</a>
      {% endif %}
      <a href="{{ settings.walk_page.url | default: "/pages/paseos" }}">Paseos y escapadas</a>
      {% if blogs['guias'].articles_count > 0 %}<a href="{{ blogs['guias'].url }}">{{ 'organic.walk_guides' | t }}</a>{% endif %}
      <a href="{{ settings.brand_page.url | default: "/pages/nosotros" }}">Nuestra idea</a>
      {% assign contact_page = section.settings.contact_page | default: pages['contact'] | default: pages['contacto'] %}
      {% if contact_page != blank %}<a href="{{ contact_page.url }}">Contacto</a>{% endif %}
    </nav>
  </div>
  <div class="wrap footer-bottom">
    <small>© {{ 'now' | date: '%Y' }} Milo & Co</small>
    <div>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type": "page","id": "contact_page","label": "Página de contacto"}
  ]
}
{% endschema %}
