<footer class="footer"><div class="wrap footer-top"><div><a class="wordmark" href="{{ routes.root_url }}">milo & co<span>.</span></a><p>La vida, en buena compañía.</p></div><nav aria-label="Información"><a href="{{ settings.brand_page.url | default: "/pages/nosotros" }}">Nuestra idea</a><a href="{{ settings.walk_page.url | default: "/pages/paseos" }}">Paseos y escapadas</a><a href="{{ settings.featured_product.url | default: settings.product_page.url | default: "/pages/dispensador" }}">El dispensador</a><a href="{{ settings.featured_product.url | default: settings.product_page.url | default: "/pages/dispensador" }}#preguntas">Preguntas</a>{% if section.settings.contact_page != blank %}<a href="{{ section.settings.contact_page.url }}">Contacto</a>{% endif %}</nav></div><div class="wrap footer-bottom"><small>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</small><div>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div></div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "page",
      "id": "contact_page",
      "label": "Página de contacto"
    }
  ]
}
{% endschema %}
