<header class="header" data-milo-ui="precision-2026-09-23">
{{ 'milo-polish.css' | asset_url | stylesheet_tag }}
{{ 'milo-product-premium.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milo-guard.js' | asset_url }}" defer></script>
<div class="header-inner wrap">
<a class="wordmark" href="{{ routes.root_url }}" aria-label="Milo & Co, inicio">milo & co<span class="brand-dot">.</span></a>
<nav aria-label="Navegación principal">
  {% if settings.sales_enabled %}
    <a href="{{ settings.products_page.url | default: '/pages/productos' }}">Productos</a>
  {% else %}
    <a href="{{ settings.product_page.url | default: '/pages/dispensador' }}">Dispensador</a>
  {% endif %}
  <a href="{{ settings.walk_page.url | default: "/pages/paseos" }}">Paseos</a>
  {% if blogs['guias'].articles_count > 0 %}<a href="{{ blogs['guias'].url }}">Guías</a>{% endif %}
  <a href="{{ settings.brand_page.url | default: "/pages/nosotros" }}">Nuestra idea</a>
</nav>
{% if settings.sales_enabled %}
  <a class="bag" href="{{ routes.cart_url }}" aria-label="Carrito, {{ cart.item_count }} {% if cart.item_count == 1 %}artículo{% else %}artículos{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z M8 8V5a4 4 0 0 1 8 0v3"/></svg><span>{{ cart.item_count }}</span></a>
{% else %}
  {% assign waitlist_href = routes.root_url | append: '#espera' %}
  {% if request.page_type == 'product' or page.handle == 'dispensador' %}{% assign waitlist_href = '#product-purchase' %}{% endif %}
  <a class="header-waitlist" href="{{ waitlist_href }}" data-milo-event="waitlist_click" data-milo-source="header">Lista de espera</a>
{% endif %}
</div>
</header>
{% schema %}
{"name":"Header","settings":[]}
{% endschema %}
