<section class="cart wrap"><h1>Vuestro próximo paseo.</h1>{% if cart.item_count == 0 %}<p>Tu carrito está vacío.</p><a class="button" href="{{ routes.root_url }}#dispensador">Descubre el dispensador {% render 'arrow' %}</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<article class="cart-row">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><a href="{{ item.url_to_remove }}" class="fine">Eliminar</a></div><label>Cantidad<input name="updates[]" type="number" min="0" value="{{ item.quantity }}" aria-label="Cantidad de {{ item.title | escape }}"></label><p>{{ item.final_line_price | money }}</p></article>{% endfor %}</div><div class="cart-total"><p>Total: {{ cart.total_price | money }}</p><p class="fine">Envío e impuestos aplicables calculados al finalizar la compra.</p><button class="button secondary" name="update" type="submit">Actualizar carrito</button>{% if settings.sales_enabled %}<button class="button" name="checkout" type="submit">Finalizar compra {% render 'arrow' %}</button>{% endif %}</div></form>{% endif %}</section>
{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
