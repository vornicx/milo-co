{% capture food_src %}{% render 'milo-photo-src', name: 'food' %}{% endcapture %}
{% capture waste_src %}{% render 'milo-photo-src', name: 'waste' %}{% endcapture %}
<section class="product-use wrap" id="como-funciona">
  <div class="product-use-head">
    <p class="eyebrow">EN EL PASEO</p>
    <h2>Lo esencial.<br>En una mano.</h2>
  </div>

  <div class="product-use-gallery" aria-label="El dispensador en uso">
    <figure class="product-use-shot product-use-shot--primary">
      {% if section.settings.image_water != blank %}
        {{ section.settings.image_water | image_url: width: 1600 | image_tag: widths: '520, 820, 1200, 1600', sizes: '(max-width: 760px) 84vw, 54vw', loading: 'lazy', alt: 'Una pausa para beber durante el paseo' }}
      {% else %}
        <img src="{{ 'paseo-pausa.webp' | asset_url }}" width="1122" height="1402" loading="lazy" alt="Una pausa durante el paseo">
      {% endif %}
    </figure>

    <figure class="product-use-shot product-use-shot--food">
      {% if section.settings.image_food != blank %}
        {{ section.settings.image_food | image_url: width: 1200 | image_tag: widths: '420, 720, 1000, 1200', sizes: '(max-width: 760px) 84vw, 30vw', loading: 'lazy', alt: 'Comida guardada en el dispensador' }}
      {% else %}
        <img src="{{ food_src | strip }}" width="1122" height="1402" loading="lazy" alt="Comida guardada en el dispensador">
      {% endif %}
    </figure>

    <figure class="product-use-shot product-use-shot--waste">
      {% if section.settings.image_waste != blank %}
        {{ section.settings.image_waste | image_url: width: 1400 | image_tag: widths: '480, 800, 1100, 1400', sizes: '(max-width: 760px) 84vw, 30vw', loading: 'lazy', alt: 'Bolsa de residuos saliendo de su compartimento' }}
      {% else %}
        <img src="{{ waste_src | strip }}" width="1536" height="1024" loading="lazy" alt="Bolsa de residuos saliendo de su compartimento">
      {% endif %}
    </figure>
  </div>

  <div class="product-use-facts" aria-label="Características de uso">
    <span><strong>400 ml</strong> agua</span>
    <span><strong>150 ml</strong> comida</span>
    <span><strong>3 en 1</strong> un accesorio</span>
  </div>
</section>
{% schema %}
{
  "name":"Dispensador en uso",
  "settings":[
    {"type":"image_picker","id":"image_water","label":"Foto · agua / bebedero"},
    {"type":"image_picker","id":"image_food","label":"Foto · comida / snacks"},
    {"type":"image_picker","id":"image_waste","label":"Foto · residuos"}
  ]
}
{% endschema %}
