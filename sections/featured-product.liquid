{% assign item = section.settings.product | default: settings.featured_product %}
{% assign product_link = item.url | default: settings.product_page.url | default: '/pages/dispensador' %}
<section id="dispensador" class="home-product">
  <div class="wrap home-product-grid">
    <div class="home-product-copy">
      <p class="eyebrow">EL DISPENSADOR</p>
      <h2>Dispensador<br>de paseo 3 en 1</h2>
      <p>{{ 'organic.product_summary' | t }}</p>
      <dl class="home-product-specs">
        <div><dt>Agua</dt><dd>400 ml</dd></div>
        <div><dt>Comida</dt><dd>150 ml</dd></div>
        <div><dt>Para llevar</dt><dd>29 cm</dd></div>
      </dl>
      <a class="button" href="{{ product_link }}">Descubrir producto {% render 'arrow' %}</a>
      {% unless settings.sales_enabled %}<span class="home-product-status">Próximamente</span>{% endunless %}
    </div>

    <figure class="home-product-media home-product-colors">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1300, 1800', sizes: '(max-width: 760px) calc(100vw - 32px), 59vw', loading: 'lazy', alt: 'Dispensadores Milo & Co en azul cielo y rosa' }}
      {% else %}
        {% render 'theme-image', filename: 'paseo-colores.webp', alt: 'Dispensadores Milo & Co en azul cielo y rosa', width: 1500, height: 1000, sizes: '(max-width: 760px) 90vw, 50vw', loading: 'lazy', priority: 'auto' %}
      {% endif %}
    </figure>
  </div>
</section>
{% schema %}
{
  "name":"Featured Product",
  "settings":[
    {"type":"product","id":"product","label":"Producto estrella"},
    {"type":"image_picker","id":"image","label":"Fotografía editorial del producto"}
  ]
}
{% endschema %}
