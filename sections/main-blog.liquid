<section class="journal wrap">
  <nav class="breadcrumbs" aria-label="{{ 'organic.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'organic.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ blog.title | escape }}</span></nav>
  <header class="journal-heading"><p class="eyebrow">{{ 'organic.journal' | t }}</p><h1>{{ blog.title | escape }}</h1><p>{{ 'organic.guides_intro' | t }}</p></header>
  {% paginate blog.articles by 9 %}
    <div class="guide-grid">{% for guide in blog.articles %}{% render 'guide-card', guide: guide %}{% else %}<p>{{ 'organic.empty_guides' | t }}</p>{% endfor %}</div>
    {% if paginate.pages > 1 %}<nav class="journal-pagination" aria-label="{{ 'organic.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Blog de guías","settings":[]}
{% endschema %}
