<section class="password-page wrap">
  <a class="wordmark" href="{{ routes.root_url }}" aria-label="Pupit & Co, inicio">pupit & co<span>.</span></a>
  <div class="password-copy">
    <p class="eyebrow">ACCESO PRIVADO</p>
    <h1>Estamos preparando<br>Pupit &amp; Co.</h1>
    <p>Si tienes la contraseña de acceso, puedes entrar a la vista privada.</p>
  </div>
  {% form 'storefront_password', class: 'pupit-form password-form' %}
    {{ form.errors | default_errors }}
    <div class="field">
      <label for="Password">Contraseña</label>
      <input type="password" name="password" id="Password" autocomplete="current-password" required>
    </div>
    <button class="button button--dark" type="submit">Entrar</button>
  {% endform %}
</section>
