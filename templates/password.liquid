<section class="page password-page wrap">
  <a class="wordmark" href="{{ routes.root_url }}" aria-label="Milo & Co, inicio">milo & co<span>.</span></a>
  <div class="password-copy">
    <p class="eyebrow">MILO & CO</p>
    <h1>Algo bueno<br>está por salir.</h1>
    <p>Estamos preparando vuestro próximo paseo.</p>
  </div>
  {% form 'storefront_password', class: 'milo-form password-form' %}
    {{ form.errors | default_errors }}
    <div class="field">
      <label for="Password">Contraseña de la tienda</label>
      <input type="password" name="password" id="Password" autocomplete="current-password" required>
    </div>
    <button class="button button--dark" type="submit">Entrar</button>
  {% endform %}
</section>
