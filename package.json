{
  "name": "pupit-co",
  "version": "2.0.0",
  "private": true,
  "description": "Pupit v2 — Shopify Dawn 16.0.0 with custom Liquid sections",
  "scripts": {
    "dev": "shopify theme dev",
    "check": "shopify theme check",
    "validate": "node scripts/validate-preview.mjs",
    "test:security": "node --test tests/prelaunch.test.mjs",
    "quality": "npm run check && npm run build",
    "package": "python3 scripts/package.py",
    "build": "node scripts/build-preview.mjs && node scripts/validate-preview.mjs",
    "test:commerce": "npm run build && node --test tests/prelaunch.test.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "4.8.0",
    "liquidjs": "10.29.0"
  }
}
