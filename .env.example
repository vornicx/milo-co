REVIEWS_S3_ACCESS_KEY=
REVIEWS_S3_SECRET_KEY=
# Two independent random secrets, at least 32 characters each.
REVIEWS_ADMIN_SECRET=
REVIEWS_HASH_SECRET=
# Exact HTTPS origins, no trailing slash. Include the real admin panel origin.
REVIEWS_ALLOWED_ORIGINS=https://miloandcompany.es,https://www.miloandcompany.es,https://bs11tg-1j.myshopify.com,https://miloco.vercel.app
