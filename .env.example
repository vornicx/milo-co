# Server only. Never paste credentials into the Shopify theme or admin HTML.
REVIEWS_DATABASE_URL=
REVIEWS_S3_BUCKET=
REVIEWS_S3_REGION=eu-west-1
# Leave empty for AWS S3. Copy endpoint and region from the provider, not a bucket URL.
REVIEWS_S3_ENDPOINT=
# post: AWS S3 POST policy. put: signed PUT for providers such as Supabase Storage.
REVIEWS_S3_UPLOAD_METHOD=post
REVIEWS_S3_ACCESS_KEY=
REVIEWS_S3_SECRET_KEY=
# Two independent random secrets, at least 32 characters each.
REVIEWS_ADMIN_SECRET=
REVIEWS_HASH_SECRET=
# Exact HTTPS origins, no trailing slash. Include the real admin panel origin.
REVIEWS_ALLOWED_ORIGINS=https://pupitandcompany.com,https://www.pupitandcompany.com,https://bs11tg-1j.myshopify.com,https://miloco.vercel.app
REVIEWS_PRODUCTS=dispensador-de-paseo-3-en-1
