{% if item != blank %}
{% assign chosen = item.selected_or_first_available_variant %}
{% if settings.sales_enabled %}
<div data-product data-product-url="{{ item.url }}">
<p class="price" data-price aria-live="polite">{{ chosen.price | money }}</p>
{% form 'product', item, class: 'product-form' %}
{{ form.errors | default_errors }}
<label data-variant-label for="Variant-{{ section.id }}">{% if item.options.size == 1 %}{{ item.options.first | escape }}{% else %}Modelo y color{% endif %}</label>
<select name="id" id="Variant-{{ section.id }}" data-variant>
{% for variant in item.variants %}<option value="{{ variant.id }}" data-title="{{ variant.title | escape }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1600 | escape }}{% endif %}" data-image-alt="{{ variant.featured_image.alt | default: item.title | escape }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}" {% if variant.id == chosen.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Agotado{% endunless %}</option>{% endfor %}
</select>
<label for="Quantity-{{ section.id }}">Cantidad</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" value="{{ chosen.quantity_rule.min | default: 1 }}" min="{{ chosen.quantity_rule.min | default: 1 }}" step="{{ chosen.quantity_rule.increment | default: 1 }}" {% if chosen.quantity_rule.max %}max="{{ chosen.quantity_rule.max }}"{% endif %} required>
<button class="button purchase-button" type="submit" data-add {% unless chosen.available %}disabled{% endunless %}>{% if chosen.available %}Añadir al carrito{% else %}Agotado{% endif %}</button>
{% endform %}
<p class="fine">{% if cart.taxes_included %}Impuestos incluidos. {% endif %}Envío calculado al finalizar la compra.{% if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}">Condiciones de envío</a>.{% endif %}{% if shop.refund_policy.body != blank %} <a href="{{ shop.refund_policy.url }}">Cambios y devoluciones</a>.{% endif %}</p>
</div>
{% else %}<p class="availability">En preparación</p>{% endif %}
{% else %}<div class="color-preview" aria-label="Colores previstos: azul cielo y rosa"><span class="sky"></span><span class="pink"></span></div><p class="availability">Próximamente</p>{% endif %}
