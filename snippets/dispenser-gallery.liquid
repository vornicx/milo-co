{% capture food_src %}{% render 'milo-photo-src', name: 'food' %}{% endcapture %}
{% capture waste_src %}{% render 'milo-photo-src', name: 'waste' %}{% endcapture %}
{% capture parts_src %}{% render 'milo-photo-src', name: 'parts' %}{% endcapture %}
<div class="product-gallery" data-gallery>
  <div class="gallery-thumbnails" aria-label="Fotografías del dispensador">
    {% if item.images.size > 0 %}
      {% assign active_image = item.selected_or_first_available_variant.featured_image | default: item.featured_image %}
      {% for photo in item.images %}
        <button type="button" data-photo="{{ photo | image_url: width: 1600 }}" data-alt="{{ photo.alt | default: item.title | escape }}" aria-label="Fotografía {{ forloop.index }} de {{ item.title | escape }}" aria-pressed="{% if photo.id == active_image.id %}true{% else %}false{% endif %}">{{ photo | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</button>
      {% endfor %}
    {% else %}
    <button type="button" data-photo="{{ food_src | strip }}" data-alt="Dispensador Milo & Co con agua y comida preparado para salir" aria-label="Producto completo" aria-pressed="true"><img src="{{ food_src | strip }}" alt="" width="80" height="100" loading="lazy"></button>
    <button type="button" data-photo="{{ 'paseo-colores.webp' | asset_url }}" data-alt="Dispensadores Milo & Co en azul cielo y rosa" aria-label="Azul cielo y rosa" aria-pressed="false"><img src="{{ 'paseo-colores.webp' | asset_url }}" alt="" width="120" height="80" loading="lazy"></button>
    <button type="button" data-photo="{{ parts_src | strip }}" data-alt="Dispensador desmontado con sus piezas y accesorios" aria-label="Piezas del dispensador" aria-pressed="false"><img src="{{ parts_src | strip }}" alt="" width="80" height="80" loading="lazy"></button>
    <button type="button" data-photo="{{ 'paseo-pausa.webp' | asset_url }}" data-alt="Dispensador durante una pausa del paseo" aria-label="Uso durante el paseo" aria-pressed="false"><img src="{{ 'paseo-pausa.webp' | asset_url }}" alt="" width="80" height="100" loading="lazy"></button>
    <button type="button" data-photo="{{ waste_src | strip }}" data-alt="Compartimento para bolsas de residuos en uso" aria-label="Compartimento para residuos" aria-pressed="false"><img src="{{ waste_src | strip }}" alt="" width="100" height="67" loading="lazy"></button>
    <button type="button" data-photo="{{ 'dispensador-detalle.webp' | asset_url }}" data-alt="Detalle del botón y la cuerda del dispensador" aria-label="Detalle del dispensador" aria-pressed="false"><img src="{{ 'dispensador-detalle.webp' | asset_url }}" alt="" width="80" height="80" loading="lazy"></button>
    {% endif %}
  </div>

  <div class="gallery-stage">
    {% if item.images.size > 0 %}
      {{ active_image | image_url: width: 1600 | image_tag: widths: '480, 800, 1200, 1600', sizes: '(max-width: 760px) 90vw, 50vw', loading: 'eager', data-gallery-main: '', data-variant-image: '' }}
    {% else %}
    <img data-gallery-main src="{{ food_src | strip }}" alt="Dispensador Milo & Co con agua y comida preparado para salir" width="1122" height="1402" loading="eager">
    {% endif %}
    <p class="image-error" hidden>No se ha podido cargar esta fotografía.</p>
  </div>
</div>
