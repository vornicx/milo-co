<div class="dispenser-gallery lifestyle-gallery" data-gallery>
  <div class="gallery-stage">
    <img data-gallery-main src="{{ 'paseo-esenciales.webp' | asset_url }}" alt="El dispensador junto a la correa, listo para salir" width="1254" height="1254" loading="eager">
    <p class="image-error" hidden>No se ha podido cargar esta fotografía.</p>
  </div>
  <div class="gallery-thumbnails" aria-label="Fotografías del dispensador">
    <button type="button" data-photo="{{ 'paseo-esenciales.webp' | asset_url }}" data-alt="El dispensador junto a la correa, listo para salir" aria-label="El dispensador junto a la correa, listo para salir" aria-pressed="true"><img src="{{ 'paseo-esenciales.webp' | asset_url }}" alt="" width="80" height="80" loading="lazy"></button>
    <button type="button" data-photo="{{ 'paseo-colores.webp' | asset_url }}" data-alt="Los dispensadores azul y rosa junto a la bolsa de paseo" aria-label="Los dispensadores azul y rosa junto a la bolsa de paseo" aria-pressed="false"><img src="{{ 'paseo-colores.webp' | asset_url }}" alt="" width="80" height="80" loading="lazy"></button>
    <button type="button" data-photo="{{ 'paseo-pausa.webp' | asset_url }}" data-alt="Una pausa para beber durante el paseo" aria-label="Una pausa para beber durante el paseo" aria-pressed="false"><img src="{{ 'paseo-pausa.webp' | asset_url }}" alt="" width="80" height="80" loading="lazy"></button>
    <button type="button" data-photo="{{ 'dispensador-detalle.webp' | asset_url }}" data-alt="Detalle del botón y la cuerda del dispensador" aria-label="Detalle del botón y la cuerda del dispensador" aria-pressed="false"><img src="{{ 'dispensador-detalle.webp' | asset_url }}" alt="" width="80" height="80" loading="lazy"></button>
  </div>
</div>
