{% assign sky_photo = 'dispenser-sky.webp' | asset_url %}{% assign pink_photo = 'dispenser-pink.webp' | asset_url %}
<div class="dispenser-gallery" data-gallery>
  <div class="gallery-stage">
    <img data-gallery-main src="{{ sky_photo }}" alt="Dispensador de paseo 3 en 1 en azul cielo" width="420" height="560" loading="eager">
    <p class="image-error" hidden>No se ha podido cargar esta fotografía.</p>
  </div>
  <div class="gallery-thumbnails" aria-label="Colores del dispensador">
    <button type="button" data-photo="{{ sky_photo }}" data-alt="Dispensador de paseo 3 en 1 en azul cielo" data-color="Azul cielo" aria-label="Ver dispensador azul cielo" aria-pressed="true">
      <img src="{{ sky_photo }}" alt="" width="105" height="140" loading="lazy"><span>Azul cielo</span>
    </button>
    <button type="button" data-photo="{{ pink_photo }}" data-alt="Dispensador de paseo 3 en 1 en rosa" data-color="Rosa" aria-label="Ver dispensador rosa" aria-pressed="false">
      <img src="{{ pink_photo }}" alt="" width="105" height="140" loading="lazy"><span>Rosa</span>
    </button>
  </div>
</div>
